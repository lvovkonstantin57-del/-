# Скопируй в .env и заполни: cp .env.example .env

# Домен сервера (A-запись должна указывать на IP сервера). Приложение на телефоне ходит сюда по HTTPS.
# Бесплатный вариант без покупки домена: 1-2-3-4.sslip.io, где цифры — IP сервера через дефис
DOMAIN=schedule.example.ru

# Порт на 127.0.0.1, к которому проксирует Caddy/nginx на сервере
APP_PORT=8080

# Код главного админа: зарегистрируйся в приложении и введи его в «Профиль → Ввести код».
# Придумай длинный случайный, например: openssl rand -hex 16
OWNER_CODE=

# Как связаться с админом напрямую (покажется в профиле): @username, почта или ссылка
ADMIN_CONTACT=

# Название в приложении и уведомлениях
APP_NAME=Расписание МПГУ

# Дата начала семестра по умолчанию (потом меняется в приложении)
SEMESTER_START=2026-09-01

TIMEZONE=Europe/Moscow

# Откуда разрешены запросы к API, кроме самого сайта. По умолчанию — приложения на телефоне:
# CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost,ionic://localhost
